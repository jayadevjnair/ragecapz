{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "ragecapz.in" }],
      "destination": "https://ragecapz.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.ragecapz.in" }],
      "destination": "https://ragecapz.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/programs", "destination": "/index.html" },
    { "source": "/idea-lab", "destination": "/index.html" },
    { "source": "/internships", "destination": "/index.html" },
    { "source": "/school-programs", "destination": "/index.html" },
    { "source": "/summer-camps", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/gallery", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
